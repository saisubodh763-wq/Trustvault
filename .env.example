# Generate each with:  python -c "import secrets; print(secrets.token_hex(32))"
# They MUST be different from each other. Keep them out of git and out of the data volume.
TRUSTVAULT_MASTER_KEY=
TRUSTVAULT_AUDIT_KEY=
TRUSTVAULT_ENV=production
TRUSTVAULT_DATA=/data
# Number of trusted reverse proxies in front of the app (0 = none). Wrong values let clients spoof their IP in the audit log.
TRUSTVAULT_PROXY_HOPS=1
# Demo only. Loads public demo accounts if the database is empty.
# TRUSTVAULT_SEED_DEMO=1
# Recommended: off-box audit anchors. MUST be outside TRUSTVAULT_DATA (separate/append-only storage).
# TRUSTVAULT_ANCHOR_FILE=/anchors/trustvault-anchors.txt

# Audit anchors: a file OUTSIDE the data directory (separate/append-only storage is best).
# Schedule `flask --app wsgi audit-anchor` every few minutes. Without it, deleting the newest audit records is undetectable.
# TRUSTVAULT_ANCHOR_FILE=/var/lib/trustvault-anchors/anchors.log
